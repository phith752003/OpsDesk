# OpsDesk Environment Configuration Example

# --- Application ---
APP_NAME=OpsDesk
APP_ENV=local
APP_KEY=base64:7Iyu9IbZbVOqpvabYKNlJnX65Zd0Dd4ljDL6Q7SMKiw=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Database Options ---
# Option A: Zero-config Local Host (Default)
DB_CONNECTION=sqlite

# Option B: Docker Compose / MySQL 8
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=opsdesk
# DB_USERNAME=opsdesk_user
# DB_PASSWORD=opsdesk_secret_password

# --- Caching & Queue ---
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
# In Docker:
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=redis
# REDIS_PORT=6379

# --- Frontend API Proxy ---
VITE_API_URL=http://localhost:8000/api/v1
